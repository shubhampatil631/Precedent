# LLM API Keys & Endpoints
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_MODELS=qwen2.5:1.5b,phi3:mini,llama3.2:1b

# Provider Priority Order: ollama -> groq -> gemini
LLM_PROVIDER_ORDER=ollama,groq,gemini

# Default Models
CLASSIFY_MODEL=qwen2.5:1.5b
DRAFT_MODEL=gemini-2.5-flash
JUDGE_MODEL=llama-3.3-70b-versatile

# Calibration & Routing Thresholds
CONFIDENCE_THRESHOLD=0.55
SIMILARITY_FLOOR=0.30
TOP_K_RETRIEVAL=5

# Chosen Brand
BRAND_AUTHOR_ID=AmericanAir
BRAND_NAME="American Airlines"
